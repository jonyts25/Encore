# API base URL (no trailing slash). Defaults to Railway production if unset.
EXPO_PUBLIC_API_URL=https://encore-api-production-5b9a.up.railway.app

# Supabase (required for M1+)
# Local dev: copy this file to .env and fill in values.
# EAS builds: set the same names in Expo → Project → Environment variables
# (environment: production), or via `npx eas env:create` — .env is not uploaded.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
